
@model IEnumerable<BlogDto>
<div class="main-panel">
    <div class="content-wrapper">
        <div class="row">

            <div class="col-lg-12 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Inverse table</h4>
                        <a asp-controller="Blog" asp-action="Create">Add Blog</a>
                        <div class="table-responsive pt-3">
                            <table class="table table-dark">
                                <thead>
                                    <tr>
                                        <th>
                                            #
                                        </th>
                                        <th>
                                            Title
                                        </th>

                                        <th>
                                            Little Title
                                        </th>
                                        <th>
                                            Description
                                        </th>
                                        <th>
                                            Comment Count
                                        </th>
                                        <th>
                                          Blog Category
                                        </th>
                                        <th>
                                            Image
                                        </th>
                                        <th>
                                            Options
                                        </th>

                                    </tr>
                                </thead>
                                <tbody>

                                    @{
                                        int count = 0;
                                        foreach (var item in Model)

                                        {
                                            <tr>
                                                <td>
                                                    @{
                                                        count += 1;
                                                    }
                                                    @count
                                                </td>
                                                <td>
                                                    @item.Title
                                                </td>
                                                <td>
                                                    @item.LittleTitle
                                                </td>
                                                <td>
                                                    @item.Description
                                                </td>
                                                <td>
                                                    @item.CommentCount
                                                </td>
    <td>
                                                    @item.BlogCategoryName
                                                </td>
                                                @if (item.ImageMain != null)
                                                {
                                                    <td>  <img src="@item.ImageMain" alt="Product Image" style="width: 50px; height: 50px;" /></td>
                                                }
                                                else
                                                {
                                                    <td><span>No Image</span></td>
                                                }
                                                <td>
                                                    <a class="btn btn-primary" asp-controller="Blog" asp-action="Update" asp-route-id="@item.Id">Edit</a>
                                                    <a class="btn btn-danger" asp-controller="Blog" asp-action="Delete" asp-route-id="@item.Id">Delete</a>

                                                </td>

                                            </tr>
                                        }
                                    }


                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

         
        </div>
    </div>




