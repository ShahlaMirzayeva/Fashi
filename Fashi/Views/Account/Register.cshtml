

@{
    ViewData["Title"] = "Register";
}
@model RegisterVm
<!-- Register Section Begin -->
<div class="register-login-section spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 offset-lg-3">
                <div class="register-form">
                    <h2>Register</h2>
                    <form asp-controller="Account" asp-action="Register"method="post">
                        <div class="text-danger" asp-validation-summary="All"></div>
                        <div class="group-input">
                            <label asp-for="UserName">Username</label>
                            <input asp-for="UserName" type="text" id="username">
                            <span class="text-danger"asp-validation-for="UserName"></span>
                        </div>
                        <div class="group-input">
                            <label asp-for="Email">Email</label>
                            <input asp-for="Email" type="text" id="email">
                            <span class="text-danger" asp-validation-for="Email"></span>
                        </div>
                        <div class="group-input">
                            <label asp-for="Address">Address</label>
                            <input asp-for="Address" type="text">
                            <span class="text-danger" asp-validation-for="Address"></span>
                        </div>
                        <div class="group-input">
                            <label asp-for="Country">Country</label>
                            <input asp-for="Country" type="text">
                            <span class="text-danger" asp-validation-for="Country"></span>
                        </div>
                        <div class="group-input">
                            <label asp-for="City">City</label>
                            <input asp-for="City" type="text">
                            <span class="text-danger" asp-validation-for="City"></span>
                        </div>
                        <div class="group-input">
                            <label asp-for="PostCode">PostCode</label>
                            <input asp-for="PostCode" type="text">
                            <span class="text-danger" asp-validation-for="PostCode"></span>
                        </div>
                        <div class="group-input">
                            <label asp-for="Password">Password *</label>
                            <input asp-for="Password" type="password" id="pass">
                            <span class="text-danger" asp-validation-for="Password"></span>
                        </div>
                        <div class="group-input">
                            <label asp-for="ConfirmPassword">Confirm Password *</label>
                            <input asp-for="ConfirmPassword" type="password" id="con-pass">
                            <span class="text-danger" asp-validation-for="ConfirmPassword"></span>
                        </div>
                        <button type="submit" class="site-btn register-btn">REGISTER</button>
                    </form>
                    <div class="switch-login">
                        <a asp-controller="Account" asp-action="Login" class="or-login">Or Login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Register Form Section End -->

