@model CreateSosialMediaVm
<div class="main-panel">
    <div class="content-wrapper">
        <div class="row">
            <div class="col-12 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Basic form elements</h4>
                        <p class="card-description">
                            Basic form elements
                        </p>
                        <form class="forms-sample" method="post" enctype="multipart/form-data">
                            <div class="form-group">
                                <label asp-for="SosialMediaLink">Sosial Media Link</label>
                                <input asp-for="SosialMediaLink" type="text" class="form-control" id="exampleInputName1" placeholder="Sosial Media Link">
                                <span asp-validation-for="SosialMediaLink" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="Icon">Icon</label>
                                <input asp-for="Icon" type="text" class="form-control" id="exampleInputIcon1" placeholder="Icon">
                                <span asp-validation-for="Icon" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="ImageUrl">Icon</label>
                                <input asp-for="ImageUrl" type="file" class="form-control" id="exampleInputIcon1" placeholder="Icon">
                                <span asp-validation-for="ImageUrl" class="text-danger"></span>
                            </div>
                     

                            <button type="submit" class="btn btn-primary me-2">Submit</button>
                            <button class="btn btn-light">Cancel</button>
                        </form>
                    </div>
                </div>
            </div>
        </<div>
    </div>



